{
  "display_information": {
    "name": "Flack",
    "description": "Reply from Android Auto to Slack messages that reach your phone."
  },
  "oauth_config": {
    "redirect_urls": [
      "https://jamditis.github.io/flack/oauth/"
    ],
    "scopes": {
      "user": [
        "chat:write",
        "search:read",
        "users:read",
        "mpim:read"
      ]
    },
    "pkce_enabled": true
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": true
  }
}
